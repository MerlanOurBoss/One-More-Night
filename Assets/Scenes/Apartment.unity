  - text: "\u0421\u043D\u0438\u043C\u043A\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E \u0441 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u043D\u0430 \u043A\u0443\u0445\u043D\u0435. \u041F\u043B\u0430\u0442\u044F\u0442 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439, \u0433\u0434\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A. \u0417\u0430 \u043F\u0443\u0441\u0442\u043E\u0439 \u2014 \u0448\u0442\u0440\u0430\u0444. \u041F\u043B\u0451\u043D\u043A\u0438 \u0447\u0435\u0442\u044B\u0440\u0435 \u043A\u0430\u0434\u0440\u0430 \u043D\u0430 \u043D\u043E\u0447\u044C.\n\n\u041B\u0435\u0433\u043A\u043E. \u0417\u0430 \u043D\u0435\u0434\u0435\u043B\u044E \u0437\u0430\u043A\u0440\u043E\u044E \u0434\u043E\u043B\u0433.\n\n\u041F\u043B\u0451\u043D\u043A\u0438 \u043F\u0440\u044F\u0447\u0443 \u0432 \u0441\u0435\u0439\u0444. \u041A\u043E\u0434 \u0440\u0430\u0437\u043E\u0431\u044C\u044E \u043F\u043E \u044D\u0442\u0438\u043C \u0437\u0430\u043F\u0438\u0441\u043A\u0430\u043C, \u043C\u0430\u043B\u043E \u043B\u0438 \u043A\u0442\u043E \u0442\u0443\u0442 \u0431\u044B\u0432\u0430\u0435\u0442."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u0412\u0435\u0449\u0438 \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F, \u043F\u043E\u043A\u0430 \u044F \u0441\u043F\u043B\u044E. \u0415\u0441\u043B\u0438 \u0441\u0440\u0430\u0437\u0443 \u043D\u0435 \u0441\u043D\u044F\u0442\u044C, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0445\u0443\u0436\u0435.\n\n\u0414\u043D\u0451\u043C \u0442\u0438\u0445\u043E. \u0421\u0438\u0436\u0443 \u0438 \u0441\u0447\u0438\u0442\u0430\u044E \u0434\u0435\u043D\u044C\u0433\u0438.\n\n\u041F\u0435\u0440\u0432\u0430\u044F \u0446\u0438\u0444\u0440\u0430: {0}."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u041F\u0440\u043E\u044F\u0432\u0438\u043B\u0430 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0438\u0435 \u0441\u043D\u0438\u043C\u043A\u0438. \u041D\u0430 \u0442\u0440\u0451\u0445 \u043A\u0442\u043E-\u0442\u043E \u0441\u0442\u043E\u0438\u0442. \u0412 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E, \u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0430.\n\n\u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u0441\u043D\u0438\u043C\u043A\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0438\u0436\u0435."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u0414\u043E\u043B\u0433 \u0437\u0430\u043A\u0440\u044B\u0442 \u0435\u0449\u0451 \u0432\u0447\u0435\u0440\u0430. \u041D\u043E \u0437\u0430 \u044D\u0442\u0443 \u043D\u043E\u0447\u044C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0437\u0430 \u043F\u0440\u043E\u0448\u043B\u0443\u044E.\n\n\u041E\u0441\u0442\u0430\u043D\u0443\u0441\u044C \u0435\u0449\u0451 \u043D\u0430 \u043E\u0434\u043D\u0443 \u043D\u043E\u0447\u044C. \u0414\u043B\u044F \u0437\u0430\u043F\u0430\u0441\u0430.\n\n\u0412\u0442\u043E\u0440\u0430\u044F \u0446\u0438\u0444\u0440\u0430: {1}."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u0423\u0442\u0440\u043E \u0432\u0441\u0451 \u0442\u0435\u043C\u043D\u0435\u0435. \u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u0447\u0435\u0433\u043E, \u0438 \u0433\u0443\u0434\u0438\u0442 \u0434\u0430\u0436\u0435 \u0434\u043D\u0451\u043C.\n\n\u041D\u0430 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u043C \u0441\u043D\u0438\u043C\u043A\u0435 \u043E\u043D\u0430 \u0443 \u0441\u0430\u043C\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u044B. \u0412\u043E\u043B\u043E\u0441\u044B \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u043B\u0438\u0446\u043E. \u0423 \u043C\u0435\u043D\u044F \u0442\u0430\u043A\u0438\u0435 \u0436\u0435."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u0421\u0435\u043C\u044C \u043D\u043E\u0447\u0435\u0439. \u0414\u0435\u043D\u0435\u0433 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0431\u044B \u0435\u0449\u0451 \u043D\u0430 \u043F\u044F\u0442\u043E\u0439.\n\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u0434\u0432\u0435\u0440\u044C. \u0417\u0430 \u043D\u0435\u0439 \u043C\u043E\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430. \u041A\u0440\u043E\u0432\u0430\u0442\u044C, \u043B\u0430\u043C\u043F\u0430, \u043A\u0430\u043C\u0435\u0440\u0430 \u0432 \u0440\u0443\u043A\u0430\u0445.\n\n\u041E\u0442\u043A\u0440\u044B\u043B\u0430 \u0435\u0449\u0451 \u0440\u0430\u0437. \u0418 \u0435\u0449\u0451.\n\n\u0422\u0440\u0435\u0442\u044C\u044F \u0446\u0438\u0444\u0440\u0430: {2}."
    ink: {r: 0.08, g: 0.1, b: 0.26, a: 1}
  - text: "\u0410\u041A\u0422\n\n\u0416\u0438\u043B\u0438\u0446\u0430 \u043D\u0430\u0439\u0434\u0435\u043D\u0430 \u0443\u0442\u0440\u043E\u043C \u043D\u0430 \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u043B\u0438\u0446\u043E\u043C \u043A \u0434\u0432\u0435\u0440\u0438. \u041F\u0430\u043B\u044C\u0446\u044B \u0441\u0431\u0438\u0442\u044B \u0432 \u043A\u0440\u043E\u0432\u044C. \u0414\u0432\u0435\u0440\u044C \u043D\u0435 \u0437\u0430\u043F\u0435\u0440\u0442\u0430, \u043A\u043B\u044E\u0447 \u0432 \u0437\u0430\u043C\u043A\u0435. \u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0441\u043C\u0435\u0440\u0442\u0438 \u043D\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430.\n\n\u041A\u0430\u043C\u0435\u0440\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0436\u0438\u043B\u044C\u0446\u0430.\n\n\u041D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C: \u0443\u0445\u043E\u0434\u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041F\u043B\u0451\u043D\u043A\u0430 \u0432 \u0441\u0435\u0439\u0444\u0435, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0446\u0438\u0444\u0440\u0430 {3}."
    ink: {r: 0.04, g: 0.04, b: 0.04, a: 1}
