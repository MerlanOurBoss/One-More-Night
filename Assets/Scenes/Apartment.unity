  shotSeconds: 10
  fadeSeconds: 0.5
  leaveSeconds: 1.2
  dim: 0.3
  lettersPerSecond: 28
  letterFade: 5
  pauseAtLineEnd: 0.35
  pauseAtFullStop: 0.25
  cards:
  - text: "\u0422\u044B \u0434\u043E\u043B\u0436\u043D\u0430 ${0}.\n\u0417\u0430\u043A\u0430\u0437\u0447\u0438\u043A \u043F\u043B\u0430\u0442\u0438\u0442 \u0437\u0430 \u0441\u043D\u0438\u043C\u043A\u0438 \u044D\u0442\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u044B."
    from: {x: 0.9, y: 1.55, z: -1.2}
    to: {x: 1.1, y: 1.5, z: 0.3}
    lookFrom: {x: 1.6, y: 1.4, z: 3.4}
    lookTo: {x: 1.9, y: 1.2, z: 3.5}
    night: 0
    anomaly: {fileID: 0}
    stage: 1
  - text: "\u0414\u043D\u0451\u043C \u0432\u0441\u0451 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E.\n\u0417\u0430\u043F\u043E\u043C\u043D\u0438, \u0433\u0434\u0435 \u0447\u0442\u043E \u0441\u0442\u043E\u0438\u0442."
    from: {x: -0.5, y: 1.6, z: 0.35}
    to: {x: -0.8, y: 1.55, z: 0.6}
    lookFrom: {x: -3, y: 1.3, z: 1.4}
    lookTo: {x: -2, y: 1.1, z: 3.5}
    night: 0
    anomaly: {fileID: 0}
    stage: 1
  - text: "\u041D\u043E\u0447\u044C\u044E \u0447\u0442\u043E-\u0442\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.\n\u041D\u0430\u0439\u0434\u0438 \u044D\u0442\u043E \u0438 \u0441\u043D\u0438\u043C\u0438.\n\u041F\u041A\u041C \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0443, \u041B\u041A\u041C \u0441\u043D\u044F\u0442\u044C."
    from: {x: -0.7, y: 1.55, z: -0.45}
    to: {x: -0.7, y: 1.5, z: -1}
    lookFrom: {x: -0.6, y: 1.3, z: -3.6}
    lookTo: {x: -0.55, y: 1.35, z: -3.5}
    night: 1
    anomaly: {fileID: 8584803113325793087}
    stage: 1
  - text: "\u0414\u043D\u0451\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u044C \u0441\u043D\u0438\u043C\u043A\u0438 \u0441 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430 \u043D\u0430 \u043A\u0443\u0445\u043D\u0435.\n\u0417\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u0430\u0445\u043E\u0434\u043A\u0443 \u043F\u043B\u0430\u0442\u044F\u0442.\n\u041F\u0443\u0441\u0442\u043E\u0439 \u043A\u0430\u0434\u0440 \u0448\u0442\u0440\u0430\u0444."
    from: {x: -0.2, y: 1.5, z: 3.2}
    to: {x: -0.42, y: 1.35, z: 2.8}
    lookFrom: {x: -0.5, y: 0.95, z: 1.89}
    lookTo: {x: -0.5, y: 0.95, z: 1.89}
    night: 0
    anomaly: {fileID: 0}
    stage: 1
  - text: "\u041F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0435 \u0440\u0430\u0441\u0442\u0451\u0442 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C.\n\u0418 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043D\u043E\u0447\u044C\u044E \u0435\u0433\u043E \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435."
    from: {x: -0.7, y: 1.5, z: 0.95}
    to: {x: -0.7, y: 1.5, z: 0.55}
    lookFrom: {x: -0.5, y: 1.45, z: -0.8}
    lookTo: {x: -0.5, y: 1.45, z: -0.8}
    night: 1
    anomaly: {fileID: 8584803113325793087}
    stage: 3
  - text: "\u041D\u0430\u0431\u0435\u0440\u0438 ${0} \u0438 \u0443\u0445\u043E\u0434\u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0440\u044C.\n\u041F\u043E\u0441\u043B\u0435 \u043D\u043E\u0447\u0438 {1} \u043E\u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0432\u0435\u0434\u0451\u0442."
    from: {x: -0.7, y: 1.55, z: -1.5}
    to: {x: -0.7, y: 1.5, z: -2.8}
    lookFrom: {x: -0.7, y: 1.2, z: -3.8}
    lookTo: {x: -0.7, y: 1.1, z: -3.8}
    night: 0
    anomaly: {fileID: 0}
    stage: 1
